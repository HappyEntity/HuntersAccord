<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HuntersAccord.Launcher.ViewModels"
        xmlns:views="using:HuntersAccord.Launcher.Views"
        xmlns:loc="using:HuntersAccord.Launcher.Localization"
        x:Class="HuntersAccord.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Tr Window.Title}"
        Icon="avares://HuntersAccord/Assets/Icon/huntersaccord-icon-256.png"
        Width="900" Height="560" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True">
  <Panel Name="Root" ClipToBounds="True">
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="{StaticResource Night200}" />
          <GradientStop Offset="0.7" Color="{StaticResource Night100}" />
          <GradientStop Offset="1" Color="#110D14" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Canvas Name="Scene" Width="900" Height="560" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            RenderTransformOrigin="50%,100%" IsHitTestVisible="False">
      <Ellipse Canvas.Left="530" Canvas.Top="-98" Width="408" Height="408">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Offset="0" Color="#3D781816" />
            <GradientStop Offset="1" Color="#00781816" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Canvas.Left="674" Canvas.Top="46" Width="120" Height="120">
        <Ellipse.Fill>
          <RadialGradientBrush Center="42%,38%" GradientOrigin="42%,38%" RadiusX="62%" RadiusY="62%">
            <GradientStop Offset="0" Color="{StaticResource MoonCore}" />
            <GradientStop Offset="0.72" Color="#4A1412" />
            <GradientStop Offset="1" Color="{StaticResource MoonRim}" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Canvas.Left="534" Canvas.Top="121" Width="300" Height="10" Opacity="0.75" Fill="{StaticResource Night100Brush}" />
      <Ellipse Canvas.Left="664" Canvas.Top="88.5" Width="220" Height="7" Opacity="0.6" Fill="{StaticResource Night100Brush}" />
      <Rectangle Canvas.Top="330" Width="900" Height="130">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#00A8968C" />
            <GradientStop Offset="0.6" Color="#0FA8968C" />
            <GradientStop Offset="1" Color="#00A8968C" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Path Fill="{StaticResource Night000Brush}"
            Data="M0,560 L0,409 L17,409 L17,386 L23,362 L29,386 L29,409 L46,409 L46,445 L62,423 L78,445 L78,420 L86,420 L86,350 L92,292 L98,350 L98,390 L108,358 L118,390 L118,362 L124,318 L130,362 L130,420 L138,420 L138,486 L164,455 L190,486 L190,481 L204,461 L219,481 L219,494 L228,494 L228,471 L234,442 L240,471 L240,494 L248,494 L248,501 L262,487 L276,501 L276,509 L294,490 L311,509 L311,521 L330,498 L348,521 L348,526 L372,497 L397,526 L416,505 L436,526 L436,528 L453,528 L453,495 L459,464 L465,495 L465,528 L482,528 L482,522 L502,503 L523,522 L523,519 L548,519 L548,510 L553,510 L553,519 L568,519 L568,511 L590,490 L612,511 L612,508 L626,508 L626,499 L631,499 L631,508 L664,508 L664,490 L692,453 L721,490 L721,477 L744,477 L744,468 L749,468 L749,477 L767,477 L767,432 L775,432 L775,362 L781,304 L787,362 L787,402 L797,370 L807,402 L807,374 L813,330 L819,374 L819,432 L827,432 L827,437 L848,417 L870,437 L870,413 L886,413 L886,382 L892,348 L898,382 L898,413 L900,410 L900,560 Z" />
    </Canvas>

    <Border IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="50%,42%" GradientOrigin="50%,42%" RadiusX="75%" RadiusY="75%">
          <GradientStop Offset="0.55" Color="#00000000" />
          <GradientStop Offset="1" Color="#B8000000" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <Border IsHitTestVisible="False" Opacity="0.05">
      <Border.Background>
        <ImageBrush Source="avares://HuntersAccord/Assets/Background/stone-noise-256.png" TileMode="Tile"
                    DestinationRect="0,0,256,256" />
      </Border.Background>
    </Border>

    <Border Margin="10" BorderThickness="1" BorderBrush="{StaticResource LineFaintBrush}" IsHitTestVisible="False" />
    <Path Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0.5,20 V0.5 H20"
          Stroke="{StaticResource Gold700Brush}" StrokeThickness="1" IsHitTestVisible="False" />
    <Path Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M0,19.5 H19.5 V0"
          Stroke="{StaticResource Gold700Brush}" StrokeThickness="1" IsHitTestVisible="False" />

    <!-- Patches and Settings: night over the title screen (the moon and the city show faintly through). -->
    <Border Name="PageVeil" Background="#F20C0A0E" IsHitTestVisible="False" IsVisible="False" />

    <Grid RowDefinitions="52,*">
      <!-- Title bar: drag anywhere along it; the tabs on the left, minimise and close on the right. -->
      <Border Background="Transparent" PointerPressed="OnTitlePressed" />
      <Border Name="TitleLine" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineFaintBrush}"
              IsHitTestVisible="False" IsVisible="False" />
      <TabStrip Name="Tabs" Margin="28,0,0,0" HorizontalAlignment="Left">
        <TabStrip.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="28" />
          </ItemsPanelTemplate>
        </TabStrip.ItemsPanel>
        <TabStripItem Content="{loc:Tr Tab.Play}" />
        <TabStripItem Content="{loc:Tr Home.Patches}" />
        <TabStripItem Content="{loc:Tr Tab.Trophies}" />
        <TabStripItem Content="{loc:Tr Home.Settings}" />
      </TabStrip>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,11,0">
        <Button Theme="{StaticResource ChromeButton}" Click="OnMinimize" ToolTip.Placement="BottomEdgeAlignedRight">
          <ToolTip.Tip>
            <ToolTip Classes="right" Content="{loc:Tr Home.Minimize}" />
          </ToolTip.Tip>
          <Path Data="M0,4.5 H8" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" />
        </Button>
        <Button Theme="{StaticResource ChromeButton}" Classes="close" Click="OnCloseWindow" ToolTip.Placement="BottomEdgeAlignedRight">
          <ToolTip.Tip>
            <ToolTip Classes="right" Content="{loc:Tr Common.Close}" />
          </ToolTip.Tip>
          <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" />
        </Button>
      </StackPanel>

      <!-- The pages; changes on Patches and Settings apply at once (no Save, no Close). -->
      <Panel Grid.Row="1">
        <views:PlayPage Name="PlayView" />
        <views:PatchesPage Name="PatchesView" DataContext="{Binding Patches}" IsVisible="False" />
        <views:TrophiesPage Name="TrophiesView" DataContext="{Binding Trophies}" IsVisible="False" />
        <views:SettingsPage Name="SettingsView" IsVisible="False" />
      </Panel>
    </Grid>

    <!-- Play without shadPS4: what would be downloaded, from where, how big; nothing is downloaded before Download (v9: a
         dialog over a dimmed window, the main button gold, not blood). -->
    <Panel IsVisible="{Binding ShowDownloadOffer}">
      <Border Background="#B8060508" />
      <Panel MaxWidth="520" Margin="32,0" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Classes="dialog">
          <StackPanel>
            <TextBlock Classes="dtitle" Margin="0,0,0,12" Text="{loc:Tr DownloadOffer.Title}" />
            <TextBlock Classes="dtext" Margin="0,0,0,8" Text="{Binding DownloadOfferText.Text}" />
            <TextBlock Classes="dnote" Margin="0,0,0,14" Text="{loc:Tr DownloadOffer.Note}" />
            <WrapPanel>
              <TextBlock FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource Ash500Brush}"
                         Text="{loc:Tr DownloadOffer.File}" />
              <TextBlock Classes="mono" Margin="0,0,10,0" VerticalAlignment="Center" Text="{Binding DownloadOfferFile}"
                         ToolTip.Tip="{Binding DownloadOfferFile}" />
              <Button Theme="{StaticResource LinkButton}" FontSize="15" VerticalAlignment="Center"
                      Content="{loc:Tr DownloadOffer.Page}" Command="{Binding OpenDownloadOfferPageCommand}" />
            </WrapPanel>
            <Border Margin="0,20,0,0" Padding="0,16,0,0" BorderBrush="{StaticResource LineFaintBrush}" BorderThickness="0,1,0,0">
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Classes="bb" IsCancel="True" Content="{loc:Tr DownloadOffer.Decline}"
                        Command="{Binding DeclineDownloadCommand}" />
                <Button Classes="bb primary" IsDefault="True" Content="{loc:Tr DownloadOffer.Accept}"
                        Command="{Binding AcceptDownloadCommand}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <Path HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0.5,14 V0.5 H14"
              Stroke="{StaticResource Gold300Brush}" StrokeThickness="1" IsHitTestVisible="False" />
        <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M0,13.5 H13.5 V0"
              Stroke="{StaticResource Gold300Brush}" StrokeThickness="1" IsHitTestVisible="False" />
      </Panel>
    </Panel>
  </Panel>
</Window>
